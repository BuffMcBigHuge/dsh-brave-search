{
  "name": "dsh-brave-search",
  "version": "1.0.0",
  "description": "Brave Search provider for DeepSeek Harness (DSH): one backend, no settings UI, key read from the credential store.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-search",
    "brave",
    "search"
  ],
  "license": "MIT",
  "author": "Marco (https://bymar.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuffMcBigHuge/dsh-brave-search.git"
  },
  "engines": {
    "node": ">=20.3"
  }
}
